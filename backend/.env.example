MONGODB_URI=...
PORT=5001
JWT_SECRET=...
INTERNAL_SERVICE_TOKEN=...

CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...

NODE_ENV=development
# In production, set to your deployed Vercel URL(s) -- comma-separated if
# more than one origin needs to call this API (e.g. production + a preview
# deploy). NODE_ENV must be anything other than "development" for the auth
# cookie to work cross-site (see backend/src/lib/jwt.js) -- Render sets
# NODE_ENV=production by default, but confirm it if auth loops after deploy.
CLIENT_URL=http://localhost:5173

# provider layer (Nishith)
RAILRADAR_API_KEY=...
GOOGLE_MAPS_API_KEY=...
AMADEUS_API_KEY=...
AMADEUS_API_SECRET=...

# Email -- password reset, welcome, booking confirmation, flash offer,
# waitlist fulfilled, complaint status (lib/emailTemplates.js has all six).
# Sent via Brevo's plain HTTPS REST API, deliberately NOT SMTP -- outbound
# SMTP ports are commonly blocked/throttled on cloud hosts (Render, Railway,
# Vercel, some Heroku tiers), which is exactly the kind of thing that works
# locally and then silently hangs once deployed. A REST call over HTTPS has
# none of that risk.
# Brevo (not Resend) specifically because it supports single-sender
# verification -- verify one email address (Senders, Domains & Dedicated IPs
# > Senders in the Brevo dashboard), no domain/DNS needed, and you can send
# to any recipient. Resend's free sandbox sender can only deliver to the
# account's own address until a full domain is verified, which needs a
# domain we don't have. MAIL_FROM must be that verified address.
# No key is required for local dev -- with it unset, the mailer logs the
# real email content to the server console instead of sending it, which is
# enough to test any of these flows end to end with curl.
BREVO_API_KEY=
MAIL_FROM=reddysathvik2005@gmail.com
WHATSAPP_TOKEN=...
WHATSAPP_PHONE_NUMBER_ID=...
WHATSAPP_BUSINESS_ACCOUNT_ID=...
WHATSAPP_WEBHOOK_VERIFY_TOKEN=...

# Tourism Publicity Generator (operator Content Generator tab). Groq is the
# primary LLM (chat + Whisper large-v3 transcription); Mistral is only used
# as an automatic chat-completion fallback if Groq fails -- there's no
# Mistral equivalent for transcription, so voice input needs Groq either way.
GROQ_API_KEY=...
MISTRAL_API_KEY=...
