MONGODB_URI=...
PORT=5001
JWT_SECRET=...

CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...

NODE_ENV=development
# In production, set to your deployed Vercel URL(s) -- comma-separated if
# more than one origin needs to call this API (e.g. production + a preview
# deploy). NODE_ENV must be anything other than "development" for the auth
# cookie to work cross-site (see backend/src/lib/jwt.js) -- Render sets
# NODE_ENV=production by default, but confirm it if auth loops after deploy.
CLIENT_URL=http://localhost:5173

# provider layer (Nishith)
RAILRADAR_API_KEY=...
GOOGLE_MAPS_API_KEY=...
AMADEUS_API_KEY=...
AMADEUS_API_SECRET=...

# Email (verification + password reset). No provider is required for local
# dev -- with these unset, the mailer logs the real verification/reset link
# to the server console instead of sending it, which is enough to test the
# whole flow with curl. Set these to send real email (any SMTP provider --
# SendGrid, Mailgun, Gmail app password, etc. all work via SMTP).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Sahyatri <no-reply@sahyatri.local>
