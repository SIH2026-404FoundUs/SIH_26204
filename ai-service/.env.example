# Authenticate locally with: gcloud auth application-default login
# A LiteLLM model id ("<provider>/<model>"), not a bare model name.
MODEL=vertex_ai/gemini-2.5-flash
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
BACKEND_URL=http://localhost:5001
INTERNAL_SERVICE_TOKEN=...
# Same value as the Express backend's own CLIENT_URL -- comma-separated if
# more than one origin needs to call this service.
CLIENT_URL=http://localhost:5173
