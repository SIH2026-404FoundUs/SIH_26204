# Trip planning tries these providers in order -- Groq, then Mistral, then
# Gemini -- falling through to the next one on any error, timeout, or empty
# result (app/agents/travel_agent.py's PROVIDER_CHAIN). A provider only joins
# the chain if its own API key below is actually set; leave a block blank to
# skip that provider entirely rather than have it fail loudly on every call.
# At least one of the three must be configured or the service refuses to start.

# 1. Groq (primary, tried first) -- groq.com, fast inference hosting for open
# models. NOT xAI's "Grok" -- easy to mix up, but a different product/
# account/API entirely. Get a key at console.groq.com.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=groq/qwen/qwen3.8-27b

# 2. Mistral (tried second, only if Groq fails or is unset)
MISTRAL_API_KEY=your_mistral_api_key
MISTRAL_MODEL=mistral/mistral-small-latest

# 3. Gemini (last resort, off by default) -- leave GOOGLE_API_KEY blank to
# keep it out of the chain entirely. Demoted from primary after repeatedly
# hitting the free tier's 20-calls/day quota during this feature's own
# testing; re-adding a key here brings it back as the lowest-priority
# fallback, not primary again, unless PROVIDER_CHAIN's order is changed too.
GOOGLE_API_KEY=
MODEL=gemini-2.5-flash

BACKEND_URL=http://localhost:5001
# Same value as the Express backend's own CLIENT_URL -- comma-separated if
# more than one origin needs to call this service.
CLIENT_URL=http://localhost:5173